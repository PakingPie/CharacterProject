        },
        {
            "m_Id": "8c6768d02d4c47d2aed0c194f6edeaa8"
        },
        {
            "m_Id": "a7343b7483dd412badb3902415f1a909"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "StrandSpecular",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 H = normalize(L + V);\nfloat ToH = dot(T, H);\nfloat sinTH = sqrt(1 - ToH * ToH);\nfloat dirAtten = smoothstep(-1, 0, ToH);\nspecular = dirAtten * pow(sinTH, exponent);"
}

